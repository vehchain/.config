[focused window]
command=xdotool getwindowfocus getwindowname
interval=1
#color=#A6D1FA
min_width=1240
align=center
separator=false

[cpu]
command=top -bn1 | grep "Cpu(s)" | sed "s/.*, *\([0-9.]*\)%* id.*/\1/" | awk '{print 100 - $1"%"}'
interval=5
label=cpu 
color=#ffffff

[battery]
command=acpi -b | grep -o '[0-9]*%' | tr -d '%'
interval=30
label=battery 
color=#ffffff

[memory]
command=free -m | awk '/^Mem:/ {printf "%.0f%%\n", ($2-$7)/$2*100}'
interval=5
label=mem 
color=#ffffff

[volume]
command=pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}'
interval=1
label=vol 
color=#ffffff

[time]
command=date "+%Y-%m-%d   %H:%M:%S"
interval=1
label=
color=#ffffff
